rules_version = '2';

// Kimlik: Google ile giriş. Her işletme (firms) sadece ortaklarına görünür.
// İşletmeye katılmak için geçerli bir davet kodu (invites/{kod}) gerekir.
//
// Hareketler (moves) değiştirilemez; sadece bir kez iptal edilebilir (çöp kutusu) ve iptal edilmiş kayıt
// bir kez "geri yüklendi" diye işaretlenebilir. Sadece iptal edilmiş kayıt kalıcı silinebilir (çöpü temizle).
// Ürünlerin stok ve kişilerin bakiye alanları hareketle aynı batch'te güncellenir.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isMember(firmId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/firms/$(firmId)).data.members;
    }

    function memberUid(firmId, uid) {
      return uid is string && uid in get(/databases/$(database)/documents/firms/$(firmId)).data.members;
    }

    // Ortak: uygulamadaki bir ortak ya da uygulamayı kullanmayan (guests) biri.
    function partnerId(firmId, id) {
      return memberUid(firmId, id)
        || (id is string && id in get(/databases/$(database)/documents/firms/$(firmId)).data.get('guests', {}));
    }

    function text(s, max) {
      return s is string && s.size() <= max;
    }

    function name(s) {
      return s is string && s.size() > 0 && s.size() <= 80;
    }

    function validFirm(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.members is list && d.members.size() <= 20
        && d.people is map
        && d.get('shares', {}) is map
        && d.get('deals', {}) is map && d.get('deals', {}).size() <= 100
        && d.get('guests', {}) is map && d.get('guests', {}).size() <= 50
        // Ayarlar: logo (küçük JPEG), fatura bilgileri, gider kategorileri, yapay zekâ anahtarı.
        && text(d.get('logo', ''), 40000)
        && d.get('info', {}) is map
        && d.get('expenseCategories', []) is list && d.get('expenseCategories', []).size() <= 50
        && d.get('paymentMethods', []) is list && d.get('paymentMethods', []).size() <= 20
        && d.get('ai', {}) is map
        && d.get('defaultVat', 0) is number
        && d.get('receipt', {}) is map
        && d.get('categoryPhotos', {}) is map && d.get('categoryPhotos', {}).size() <= 60
        && d.get('productCats', []) is list && d.get('productCats', []).size() <= 100
        && d.get('currency', 'TRY').matches('^[A-Z]{3}$');
    }

    function optNumber(d, key) {
      return !(key in d) || d[key] is number;
    }

    function validProduct(d) {
      return name(d.name)
        && text(d.unit, 12)
        && d.price is int && d.price >= 0
        && d.stock is number && d.value is number && d.lastCost is number
        && optNumber(d, 'consigned')
        && text(d.get('barcode', ''), 64)
        && text(d.get('thumb', ''), 40000)
        && text(d.get('variant', ''), 40)
        && text(d.get('groupId', ''), 40)
        && text(d.get('category', ''), 40)
        && optNumber(d, 'minStock')
        && optNumber(d, 'vat')
        && optNumber(d, 'fuel')
        && d.get('barcodes', []) is list && d.get('barcodes', []).size() <= 20
        && d.get('extras', []) is list && d.get('extras', []).size() <= 10
        && trashable(d, d.stock == 0 && d.value == 0 && d.get('consigned', 0) == 0);
    }

    function validParty(d) {
      return d.kind in ['supplier', 'seller', 'person']
        && name(d.name)
        && text(d.phone, 24)
        && text(d.note, 200)
        && d.balance is number
        && (!('currency' in d) || (d.currency is string && d.currency.matches('^[A-Z]{3}$')))
        && (!('shelf' in d) || d.shelf is map)
        && text(d.get('thumb', ''), 40000)
        && text(d.get('taxNo', ''), 20)
        && text(d.get('taxOffice', ''), 60)
        && text(d.get('address', ''), 300)
        && d.get('prices', {}) is map && d.get('prices', {}).size() <= 1000
        && trashable(d, d.balance == 0);
    }

    // Çöp kutusu: "deleted" işareti sadece silinebilecek kayda konur (stoksuz ürün, bakiyesiz cari).
    function trashable(d, empty) {
      return !('deleted' in d) || (empty && d.deleted.by == request.auth.uid);
    }

    // Faturadan okunan alışlar uzun olabilir.
    function validLines(d) {
      return d.lines is list && d.lines.size() > 0 && d.lines.size() <= 100;
    }

    function validMove(firmId, d) {
      return d.type in ['purchase', 'payment', 'sale', 'collection', 'consign', 'consignSale', 'return',
          'saleReturn', 'refund', 'expense', 'capitalIn', 'withdraw', 'transfer', 'opening', 'stockCount', 'costFix', 'debtOut', 'debtIn', 'fundMove', 'fundAdjust', 'purchaseReturn', 'supplierRefund']
        && text(d.party, 40) && text(d.partyName, 80)
        && (d.type in ['opening', 'expense', 'capitalIn', 'withdraw', 'transfer', 'stockCount', 'costFix', 'fundMove', 'fundAdjust'] || d.party.size() > 0)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.total is int
        && text(d.note, 200)
        && d.by == request.auth.uid
        && !('voided' in d)
        && (!('currency' in d) || (d.currency is string && d.currency.matches('^[A-Z]{3}$') && d.rate is number && d.rate > 0))
        && (!('holder' in d) || memberUid(firmId, d.holder))
        && (!('partner' in d) || (d.type in ['capitalIn', 'withdraw'] && partnerId(firmId, d.partner)))
        && (!('deal' in d) || (d.type == 'expense' && text(d.deal, 40)))
        && (!('category' in d) || (d.type == 'expense' && text(d.category, 40) && text(d.get('categoryName', ''), 60)))
        && (!('method' in d) || (text(d.method, 40) && text(d.get('methodName', ''), 40)))
        && (!('toMethod' in d) || (d.type == 'fundMove' && text(d.toMethod, 40) && text(d.get('toMethodName', ''), 40)))
        && text(d.get('invoiceNo', ''), 40)
        && (!('discount' in d) || (d.type == 'sale' && d.discount is int && d.discount >= 0))
        && ((d.type in ['purchase', 'sale', 'consign', 'consignSale', 'return', 'saleReturn', 'stockCount', 'costFix', 'purchaseReturn'] && validLines(d))
          || (d.type in ['payment', 'collection', 'refund', 'expense', 'capitalIn', 'withdraw', 'debtOut', 'debtIn', 'supplierRefund'] && d.amount is int && d.amount > 0)
          || (d.type == 'transfer' && d.amount is int && d.amount > 0 && memberUid(firmId, d.to) && d.to != d.holder)
          || (d.type == 'fundMove' && d.amount is int && d.amount > 0 && d.toMethod is string && d.toMethod != d.get('method', 'cash'))
          || (d.type == 'fundAdjust' && d.amount is int && d.amount != 0)
          || (d.type == 'opening' && (validLines(d) || d.amount is int)));
    }

    match /firms/{firmId} {
      // Yeni ortak: sadece kendini ekleyebilir, sadece kendi kişi bilgisini yazabilir
      // ve bu işletmeye ait geçerli bir davet kodu göstermelidir.
      function joining() {
        let before = resource.data;
        let after = request.resource.data;
        return !(request.auth.uid in before.members)
          && after.members.toSet() == before.members.toSet().union([request.auth.uid].toSet())
          && after.diff(before).affectedKeys().hasOnly(['members', 'people', 'joinedWith'])
          && after.people.diff(before.people).affectedKeys().hasOnly([request.auth.uid])
          && after.joinedWith is string
          && get(/databases/$(database)/documents/invites/$(after.joinedWith)).data.firmId == firmId;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && validFirm(request.resource.data)
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && validFirm(request.resource.data)
        && (request.auth.uid in resource.data.members || joining());

      match /products/{id} {
        allow read: if isMember(firmId);
        allow create, update: if isMember(firmId) && validProduct(request.resource.data);
        // Hareketlerde ürün adı saklandığı için defter bozulmaz; yine de stoğu olan ürün silinmez.
        allow delete: if isMember(firmId) && resource.data.stock == 0 && resource.data.value == 0;
      }

      match /parties/{id} {
        allow read: if isMember(firmId);
        allow create: if isMember(firmId) && validParty(request.resource.data);
        // Tür değişmez; para birimi sadece bakiye sıfırken değişir.
        allow update: if isMember(firmId)
          && validParty(request.resource.data)
          && request.resource.data.kind == resource.data.kind
          && (request.resource.data.get('currency', 'TRY') == resource.data.get('currency', 'TRY')
            || resource.data.balance == 0);
        allow delete: if isMember(firmId) && resource.data.balance == 0;
      }

      // Ürünün büyük fotoğrafı (küçültülmüş JPEG data URL; ücretsiz planda Storage olmadığı için).
      match /images/{productId} {
        allow read, delete: if isMember(firmId);
        allow create, update: if isMember(firmId)
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 400000
          && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*');
      }

      // Ortak kasaları ve aylık kâr özetleri (hareketlerle aynı batch'te güncellenir).
      match /accounts/{uid} {
        allow read: if isMember(firmId);
        allow create, update: if isMember(firmId)
          && optNumber(request.resource.data, 'cash') && optNumber(request.resource.data, 'capital');
      }

      // Kasalar (nakit, kart, banka…): hareketlerle aynı batch'te güncellenir.
      match /funds/{id} {
        allow read: if isMember(firmId);
        allow create, update: if isMember(firmId) && optNumber(request.resource.data, 'balance');
      }

      match /months/{month} {
        allow read: if isMember(firmId);
        allow create, update: if isMember(firmId)
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && optNumber(request.resource.data, 'revenue')
          && optNumber(request.resource.data, 'cogs')
          && optNumber(request.resource.data, 'expenses');
      }

      match /moves/{id} {
        allow read: if isMember(firmId);
        allow create: if isMember(firmId) && validMove(firmId, request.resource.data);
        // İptal (çöp kutusuna taşıma): sadece "voided" alanı bir kez yazılabilir.
        // Çöp kutusundan geri yükleme: iptal edilmiş kayda sadece "restored" alanı bir kez yazılabilir
        // (kaydın kopyası aynı batch'te yeni hareket olarak yazılır; eskisi iptal kalır).
        allow update: if isMember(firmId) && (
          (!('voided' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided'])
            && request.resource.data.voided.by == request.auth.uid
            && text(request.resource.data.voided.reason, 200))
          || ('voided' in resource.data && !('restored' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restored'])
            && request.resource.data.restored.by == request.auth.uid
            && request.resource.data.restored.move is string));
        // Çöp kutusunu temizle: sadece silinmiş (iptal edilmiş) kayıt kalıcı silinir; etkisi zaten geri alınmıştır.
        allow delete: if isMember(firmId) && 'voided' in resource.data;
      }
    }

    // Fiş bağlantısı: müşteriye WhatsApp'tan giden fiş. Kodu (20 harflik rastgele kimlik) bilen herkes
    // tek tek okuyabilir; listelenemez, değiştirilemez. Sadece işletmenin ortağı yazar ve siler.
    match /shared/{id} {
      allow get: if true;
      allow create: if id.size() >= 20
        && isMember(request.resource.data.firm)
        && request.resource.data.keys().hasOnly(['firm', 'by', 'at', 'lang', 'doc', 'labels'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.lang in ['tr', 'ar']
        && request.resource.data.doc is map
        && request.resource.data.labels is map;
      allow delete: if isMember(resource.data.firm);
    }

    // Online mağaza (vitrin): herkes okur; sadece işletmenin ortakları yazar. Adres (slug) bir kez
    // alınınca başka işletme alamaz. Ürün kopyalarında maliyet ve stok adedi yoktur.
    match /shops/{slug} {
      function shopOwner() {
        return isMember(get(/databases/$(database)/documents/shops/$(slug)).data.firm);
      }
      allow get: if true;
      allow create: if slug.matches('^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$')
        && isMember(request.resource.data.firm)
        && request.resource.data.by == request.auth.uid;
      allow update: if isMember(resource.data.firm) && request.resource.data.firm == resource.data.firm;
      allow delete: if isMember(resource.data.firm);

      match /items/{id} {
        allow read: if true;
        allow write: if shopOwner();
      }
      match /images/{id} {
        allow get: if true;
        allow write: if shopOwner();
      }
      // Müşteri siparişi: girişsiz oluşturulur (şekli ve boyutu sınırlı); kodu bilen tek tek okuyabilir
      // (siparişin fotoğraf/PDF bağlantısı). Listeleme, değiştirme ve silme sadece işletmenin.
      match /orders/{id} {
        allow get: if true;
        allow list, update, delete: if shopOwner();
        allow create: if get(/databases/$(database)/documents/shops/$(slug)).data.open == true
          && request.resource.data.keys().hasOnly(['code', 'name', 'phone', 'note', 'lines', 'total', 'currency', 'at', 'status', 'via'])
          && text(request.resource.data.code, 12)
          && name(request.resource.data.name)
          && text(request.resource.data.phone, 24)
          && text(request.resource.data.note, 300)
          && request.resource.data.lines is list && request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 100
          && request.resource.data.total is int
          && text(request.resource.data.currency, 3)
          && request.resource.data.at == request.time
          && request.resource.data.status == 'new'
          && request.resource.data.via in ['whatsapp', 'direct'];
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      // İşletme ile aynı batch içinde oluşturulduğu için getAfter kullanılır.
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{6}$')
        && request.auth.uid in getAfter(/databases/$(database)/documents/firms/$(request.resource.data.firmId)).data.members;
    }
  }
}
