{
  "hosting": [
    {
      "site": "kervanim",
      "public": "public",
      "ignore": ["**/.*"],
      "headers": [
        { "source": "**/*.@(html|js|css|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ],
      "rewrites": [
        { "source": "/r/**", "destination": "/fis.html" },
        { "source": "/m/*/manifest.webmanifest", "destination": "/magaza.webmanifest" },
        { "source": "/m/*/sw.js", "destination": "/magaza-sw.js" },
        { "source": "/m/**", "destination": "/magaza.html" }
      ]
    },
    {
      "site": "kervan-7c9f64",
      "public": "public",
      "ignore": ["**/.*"],
      "headers": [
        { "source": "**/*.@(html|js|css|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ],
      "rewrites": [
        { "source": "/r/**", "destination": "/fis.html" },
        { "source": "/m/*/manifest.webmanifest", "destination": "/magaza.webmanifest" },
        { "source": "/m/*/sw.js", "destination": "/magaza-sw.js" },
        { "source": "/m/**", "destination": "/magaza.html" }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
